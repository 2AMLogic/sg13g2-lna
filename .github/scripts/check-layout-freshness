#!/usr/bin/env bash
# Check that committed layout evidence is mutually consistent (issue #86).
# Headless, PDK-free, no klayout/klt; bash + python3 stdlib only. Read-only
# on the checkout (regeneration runs in a temporary repo-shaped copy).
#
# Checks for layout/<cell> (default lna_core):
#   1. sha256(<cell>.gds) == gds_sha256 in <cell>.provenance.json
#   2. layout/lvs_reference.py regenerated from the current netlist
#      byte-equals the committed <cell>.lvs_reference.spice
#   3. provenance.input of drc_report.json, lvs_full_report.json,
#      extract_report.json and lvs_report.json (scoped LVS) has
#      role == "layout" and content_hash == sha256:<committed GDS sha256>
#   4. lvs_inputs.json (issue #130) binds each LVS report's exact bytes to the
#      GDS, reference netlist and request bytes of the invocation that made
#      it; any changed relationship is reported by name
#   5. the output named by extract_report.json (netlist_path, relative to the
#      report dir, repo-local) hashes byte-for-byte to netlist_sha256 (#176)
#   6. the native DRC pair (issue #185): native_drc_report.json +
#      native_drc_inputs.json, written by layout/run_native_drc.py, may be
#      entirely absent (no native verdict exists until issue #201 supplies
#      one) but never one-sided; when both exist the sidecar must bind the
#      report's exact bytes and the committed GDS, match the report's own
#      status and provenance deck/pdk, and record a standalone executable
#      version >= its recorded minimum
#   7. inductance_report.json (issue #400): the committed report has exactly
#      the realization's inductor2 instances, each with geometry_um equal to
#      the realization params and drawn_lowfreq_H equal to the low-frequency
#      L re-evaluated here (inductance_lowfreq.py, beside this gate; kept
#      equal to layout/inductance_report.py by a layout/tests case); and
#      netlist_H equal to the value re-parsed from the inductor2 cards of the
#      realization's netlist, drawn_over_netlist equal to the rounded ratio
#      (issue #403)
#   8. extract_report.json connectivity (issue #424), lna_core only:
#      split_net_labels must be empty (the assembled layout joins every
#      labelled net) and merged_net_labels exactly the three known spiral
#      merge groups e1|vss, outn|vdd, rfin|xin (the sg13g2 extraction deck
#      has no inductor class — layout/README.md "Friction"), order-
#      independent. The expected set lives here, not in the report under
#      test, so a regressed report cannot redefine its own expectation.
#      Scoped to lna_core: the merge groups are this cell's assembly facts;
#      other --cell values do not inherit its net names.
#
# Usage: check-layout-freshness [--root DIR] [--cell NAME]
set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
CELL=lna_core
while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT="$2"; shift 2 ;;
    --cell) CELL="$2"; shift 2 ;;
    *) echo "usage: $0 [--root DIR] [--cell NAME]" >&2; exit 2 ;;
  esac
done

exec python3 -I - "$ROOT" "$CELL" "$HERE" <<'PY'
import hashlib, importlib.util, json, os, shutil, subprocess, sys, tempfile
from pathlib import Path

root, cell = Path(sys.argv[1]).resolve(), sys.argv[2]
cd = root / "layout" / cell
errs = []

# The native-DRC pair check (STATUSES, the version helpers, the whole pair
# validation) lives once, in native_drc_pair.py beside this gate — operator
# ruling (rjwalters, 2026-11-17, issue #359): the gate executes only code
# from its own directory and must not import the logic it judges with from
# layout/, the directory whose output it judges. dont_write_bytecode first:
# a __pycache__/ write would break this gate's read-only-on-the-checkout
# guarantee.
sys.dont_write_bytecode = True
if "native_drc_pair" in sys.modules:
    _pair = sys.modules["native_drc_pair"]
else:
    _pair_spec = importlib.util.spec_from_file_location(
        "native_drc_pair", os.path.join(sys.argv[3], "native_drc_pair.py"))
    _pair = importlib.util.module_from_spec(_pair_spec)
    sys.modules["native_drc_pair"] = _pair
    _pair_spec.loader.exec_module(_pair)
check_pair = _pair.check_pair

# Same rule, same reason, for the low-frequency inductor model (issue #400).
if "inductance_lowfreq" in sys.modules:
    _ind = sys.modules["inductance_lowfreq"]
else:
    _ind_spec = importlib.util.spec_from_file_location(
        "inductance_lowfreq", os.path.join(sys.argv[3], "inductance_lowfreq.py"))
    _ind = importlib.util.module_from_spec(_ind_spec)
    sys.modules["inductance_lowfreq"] = _ind
    _ind_spec.loader.exec_module(_ind)
l_lowfreq = _ind.l_lowfreq
netlist_values = _ind.netlist_values

def fail(rel, msg):
    errs.append(f"layout-freshness: {rel}: {msg}")

def load(p):
    try:
        return json.loads(p.read_text())
    except Exception as e:
        fail(p.relative_to(root), f"unreadable JSON ({e})")
        return None

gds = cd / f"{cell}.gds"
gds_sha = None
if gds.is_file():
    gds_sha = hashlib.sha256(gds.read_bytes()).hexdigest()
else:
    fail(gds.relative_to(root), "missing")

# 1. GDS vs provenance
prov = load(cd / f"{cell}.provenance.json")
if prov is not None and gds_sha is not None:
    want = prov.get("gds_sha256")
    if want != gds_sha:
        fail(f"layout/{cell}/{cell}.provenance.json",
             f"gds_sha256 {want!r} != sha256 of committed GDS {gds_sha}")

# 2. regenerate the LVS reference in a temp repo-shaped copy
committed = cd / f"{cell}.lvs_reference.spice"
rz = load(cd / "realization.json")
if rz is not None:
    net_rel = rz.get("netlist")
    srcs = {
        "layout/lvs_reference.py": root / "layout" / "lvs_reference.py",
        f"layout/{cell}/realization.json": cd / "realization.json",
        str(net_rel): root / str(net_rel),
    }
    missing = [k for k, v in srcs.items() if not v.is_file()]
    if not net_rel or missing or not committed.is_file():
        fail(f"layout/{cell}", f"missing inputs for regeneration: "
             f"{missing or [committed.name]}")
    else:
        with tempfile.TemporaryDirectory() as t:
            t = Path(t)
            for k, v in srcs.items():
                (t / k).parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(v, t / k)
            r = subprocess.run(
                [sys.executable, "-I", str(t / "layout/lvs_reference.py"),
                 str(t / "layout" / cell)],
                capture_output=True, text=True)
            out = t / "layout" / cell / f"{cell}.lvs_reference.spice"
            if r.returncode != 0:
                fail(f"layout/{cell}/{cell}.lvs_reference.spice",
                     "regeneration failed against current netlist: "
                     + (r.stderr.strip() or r.stdout.strip()))
            elif out.read_bytes() != committed.read_bytes():
                fail(f"layout/{cell}/{cell}.lvs_reference.spice",
                     f"stale: differs from regeneration of {net_rel}")

# 3. report envelopes pinned to the committed GDS
# (extraction / scoped LVS are pinned to the GDS only; they are not signoff
# evidence. The extraction output digest is checked separately in step 5.)
for name in ("drc_report.json", "lvs_full_report.json",
             "extract_report.json", "lvs_report.json"):
    rel = f"layout/{cell}/{name}"
    rep = load(cd / name)
    if rep is None:
        continue
    inp = (rep.get("provenance") or {}).get("input")
    if not isinstance(inp, dict):
        fail(rel, "missing provenance.input")
        continue
    if inp.get("role") != "layout":
        fail(rel, f"provenance.input.role is {inp.get('role')!r}, want 'layout'")
    ch = inp.get("content_hash")
    if not isinstance(ch, str) or not ch.startswith("sha256:"):
        fail(rel, f"provenance.input.content_hash missing or malformed ({ch!r})")
    elif gds_sha is not None and ch[len("sha256:"):] != gds_sha:
        fail(rel, f"provenance.input.content_hash {ch} != sha256:{gds_sha} (committed GDS)")

# 5. extraction output named by extract_report.json (issue #176): the file at
# netlist_path (relative to the report's directory, repo-local) must hash,
# byte for byte, to netlist_sha256.
def check_extract_output():
    rel = f"layout/{cell}/extract_report.json"
    rep = load(cd / "extract_report.json") if (cd / "extract_report.json").is_file() else None
    if not isinstance(rep, dict):
        return  # missing/unreadable already reported by step 3
    npath, nsha = rep.get("netlist_path"), rep.get("netlist_sha256")
    ok = True
    if not isinstance(npath, str) or not npath or "\0" in npath:
        fail(rel, f"netlist_path missing or malformed ({npath!r})"); ok = False
    elif Path(npath).is_absolute():
        fail(rel, f"netlist_path {npath!r} is absolute; must be relative to the report directory"); ok = False
    if not isinstance(nsha, str) or len(nsha) != 64 or any(c not in "0123456789abcdef" for c in nsha):
        fail(rel, f"netlist_sha256 missing or malformed ({nsha!r}); want 64 lowercase hex"); ok = False
    if not ok:
        return
    out = (cd / npath).resolve()
    if not out.is_relative_to(root):
        fail(rel, f"netlist_path {npath!r} escapes the repository"); return
    if not out.is_file():
        fail(rel, f"netlist_path {npath!r}: extraction output {out.relative_to(root)} missing"); return
    got = hashlib.sha256(out.read_bytes()).hexdigest()
    if got != nsha:
        fail(rel, f"extraction output {out.relative_to(root)} sha256 {got} != "
             f"netlist_sha256 {nsha}; rerun layout/run_flow.sh")

check_extract_output()

# 8. extraction connectivity (issue #424): an opened net is currently
# silent everywhere else — DRC sees shorts not opens, the assembly test
# drives a recording canvas, and the LVS counts are already mismatch by
# expectation (#230). split_net_labels and merged_net_labels are the
# strongest regression signal the flow already records, so gate them here.
EXPECTED_MERGED_NETS = ("e1|vss", "outn|vdd", "rfin|xin")

def check_extract_connectivity():
    if cell != "lna_core":
        return  # expected merge groups are an lna_core assembly fact (#424)
    rel = f"layout/{cell}/extract_report.json"
    p = cd / "extract_report.json"
    if not p.is_file():
        return  # missing report already reported by check 3
    rep = load(p)
    if not isinstance(rep, dict):
        return  # unreadable JSON already reported
    splits = rep.get("split_net_labels")
    if not isinstance(splits, list):
        fail(rel, f"split_net_labels missing or malformed ({splits!r}); want a list")
    else:
        named = []
        for s in splits:
            if isinstance(s, dict) and isinstance(s.get("label"), str) \
                    and isinstance(s.get("nets"), list):
                named.append(f"{s['label']} (nets "
                             + ", ".join(str(n) for n in s["nets"]) + ")")
            else:
                named.append(repr(s))
        if named:
            fail(rel, "split_net_labels non-empty: " + "; ".join(named)
                 + "; the assembled layout must join every labelled net; "
                 "rerun layout/run_flow.sh")
    merged = rep.get("merged_net_labels")
    if not isinstance(merged, list):
        fail(rel, f"merged_net_labels missing or malformed ({merged!r}); want a list")
        return
    got = []
    for e in merged:
        if isinstance(e, dict) and isinstance(e.get("net"), str) \
                and isinstance(e.get("labels"), list) \
                and all(isinstance(x, str) for x in e["labels"]):
            got.append(e["net"])
        else:
            fail(rel, f"merged_net_labels entry malformed ({e!r}); want an "
                 "object with a 'net' name and a 'labels' array of strings")
    missing = [n for n in EXPECTED_MERGED_NETS if n not in got]
    extra = sorted(set(got) - set(EXPECTED_MERGED_NETS))
    if missing:
        fail(rel, f"merged_net_labels missing expected merge group(s) {missing}; "
             "the sg13g2 deck merges exactly the three inductor spirals "
             "(layout/README.md \"Friction\"); rerun layout/run_flow.sh")
    if extra:
        fail(rel, f"merged_net_labels has unexpected merge group(s) {extra}; a "
             "new merge is a short the assembled layout must not have; "
             "rerun layout/run_flow.sh")

check_extract_connectivity()

# 4. LVS input identity sidecar (written by layout/lvs_identity.py)
def sha(p):
    return hashlib.sha256(p.read_bytes()).hexdigest()

side_rel = f"layout/{cell}/lvs_inputs.json"
side = load(cd / "lvs_inputs.json") if (cd / "lvs_inputs.json").is_file() else None
if side is None and not (cd / "lvs_inputs.json").is_file():
    fail(side_rel, "missing (regenerate with layout/run_flow.sh)")
if side is not None:
    reps = side.get("reports") if isinstance(side, dict) else None
    if not isinstance(side, dict) or side.get("schema") != "sg13g2-lna.lvs-inputs/1" \
            or not isinstance(reps, dict):
        fail(side_rel, "malformed (bad schema or reports)")
        reps = None
    for rep_name, req_name in (("lvs_report.json", "lvs_request.json"),
                               ("lvs_full_report.json", "lvs_full_request.json")):
        if reps is None:
            break
        rel = f"{side_rel}[{rep_name}]"
        e = reps.get(rep_name)
        keys = ("request", "request_sha256", "reference", "reference_sha256",
                "gds", "gds_sha256", "report_sha256")
        if not isinstance(e, dict) or any(not isinstance(e.get(k), str) for k in keys):
            fail(rel, "missing or malformed entry")
            continue
        def cmp(what, recorded, path):
            if not path.is_file():
                fail(rel, f"{what}: {path.relative_to(root) if path.is_relative_to(root) else path} missing")
            elif sha(path) != recorded:
                fail(rel, f"{what} changed since this LVS ran "
                     f"(recorded {recorded[:12]}, now {sha(path)[:12]}); rerun layout/run_flow.sh")
        if e["request"] != req_name:
            fail(rel, f"request is {e['request']!r}, want {req_name!r}")
        cmp(f"request {req_name}", e["request_sha256"], cd / req_name)
        cmp(f"report {rep_name}", e["report_sha256"], cd / rep_name)
        # reference / GDS: paths come from the committed request, and the
        # recorded paths must agree with them.
        try:
            spec = json.loads((cd / req_name).read_bytes())
            ref_p = (cd / spec["reference"]["netlist"]).resolve()
            gds_p = (cd / spec["layout"]["file"]).resolve()
        except Exception as ex:
            fail(rel, f"cannot resolve reference/layout from {req_name} ({ex})")
            continue
        for what, path, key in (("reference", ref_p, "reference"), ("gds", gds_p, "gds")):
            try:
                want = str(path.relative_to(root))
            except ValueError:
                want = str(path)
            if e[key] != want:
                fail(rel, f"{what} path {e[key]!r} != {want!r} named by {req_name}")
        cmp(f"reference netlist {e['reference']}", e["reference_sha256"], ref_p)
        cmp(f"GDS {e['gds']}", e["gds_sha256"], gds_p)

# 6. native DRC pair (written by layout/run_native_drc.py, issue #185).
#    Checked by check_pair from native_drc_pair.py, loaded above: the one
#    implementation of the vocabulary/version/pair contract, shared since
#    the operator ruling in issue #359 with layout/run_native_drc.py and
#    layout/native_drc_identity.py (which previously kept three copies
#    equal via a sync test). Entirely absent: allowed — no native verdict
#    exists in this tree until issue #201 supplies one. One-sided or
#    inconsistent: fails, naming it.
check_pair(cd, root, f"layout/{cell}", gds, gds_sha, fail)

# 7. inductance report vs realization geometry (issue #400). Recomputes the
# low-frequency L of every inductor2 in realization.json and compares it to
# the committed report, so a geometry edit not followed by layout/run_flow.sh
# cannot leave the report stale with CI green.
def check_inductance_report():
    rel = f"layout/{cell}/inductance_report.json"
    p = cd / "inductance_report.json"
    if not p.is_file():
        fail(rel, "missing (regenerate with layout/run_flow.sh)")
        return
    rep = load(p)
    if rep is None:
        return
    rows = rep.get("inductors") if isinstance(rep, dict) else None
    if not isinstance(rows, dict):
        fail(rel, "malformed (no 'inductors' object)")
        return
    if rz is None or not isinstance(rz.get("in_scope"), dict):
        return  # unreadable realization already reported by step 2
    want = {k: v for k, v in rz["in_scope"].items()
            if isinstance(v, dict) and v.get("pcell") == "inductor2"}
    if set(rows) != set(want):
        fail(rel, f"inductors {sorted(rows)} != inductor2 instances in "
             f"realization.json {sorted(want)}; rerun layout/run_flow.sh")
    nl_rel = rz.get("netlist")
    nl_vals = {}
    if isinstance(nl_rel, str) and nl_rel and (root / nl_rel).is_file():
        nl_vals = netlist_values((root / nl_rel).read_text(), set(want))
    for inst in sorted(set(rows) & set(want)):
        row, par = rows[inst], want[inst].get("params") or {}
        try:
            geo = {"w": float(str(par["w"]).rstrip("uU")),
                   "s": float(str(par["s"]).rstrip("uU")),
                   "d": float(str(par["d"]).rstrip("uU")),
                   "turns": int(par["nr_r"])}
        except (KeyError, ValueError, TypeError) as ex:
            fail(f"layout/{cell}/realization.json", f"{inst}: unusable inductor2 params ({ex!r})")
            continue
        got = row.get("geometry_um") if isinstance(row, dict) else None
        if not isinstance(got, dict) or any(
                not isinstance(got.get(k), (int, float)) or isinstance(got.get(k), bool)
                or abs(got[k] - v) > 1e-9 for k, v in geo.items()):
            fail(rel, f"{inst}: geometry_um {got!r} != realization.json params {geo}; "
                 "rerun layout/run_flow.sh")
            continue
        lval = l_lowfreq(geo["turns"], geo["w"], geo["s"], geo["d"])
        rec = row.get("drawn_lowfreq_H")
        if not isinstance(rec, (int, float)) or isinstance(rec, bool) \
                or abs(rec - lval) > 1e-9 * abs(lval):
            fail(rel, f"{inst}: drawn_lowfreq_H {rec!r} != {lval!r} recomputed from "
                 "realization.json geometry; rerun layout/run_flow.sh")
            continue
        # netlist_H and drawn_over_netlist (issue #403)
        nl = nl_vals.get(inst)
        if nl is None:
            fail(rel, f"{inst}: no parsable inductor2 card in netlist {nl_rel!r}; "
                 "cannot verify netlist_H")
            continue
        rnl = row.get("netlist_H")
        if not isinstance(rnl, (int, float)) or isinstance(rnl, bool) \
                or abs(rnl - nl) > 1e-9 * abs(nl):
            fail(rel, f"{inst}: netlist_H {rnl!r} != {nl!r} re-parsed from {nl_rel}; "
                 "rerun layout/run_flow.sh")
            continue
        ratio = row.get("drawn_over_netlist")
        if not isinstance(ratio, (int, float)) or isinstance(ratio, bool) \
                or abs(ratio - round(lval / nl, 5)) > 1e-9:
            fail(rel, f"{inst}: drawn_over_netlist {ratio!r} != {round(lval / nl, 5)!r} "
                 "(round(drawn_lowfreq_H / netlist_H, 5)); rerun layout/run_flow.sh")

check_inductance_report()

if errs:
    print("\n".join(errs), file=sys.stderr)
    print(f"layout-freshness: FAILED ({len(errs)} problem(s))", file=sys.stderr)
    sys.exit(1)
print(f"layout-freshness: ok ({cell})")
PY
