#!/usr/bin/env bash
# Check that committed layout evidence is mutually consistent (issue #86).
# Headless, PDK-free, no klayout/klt; bash + python3 stdlib only. Read-only
# on the checkout (regeneration runs in a temporary repo-shaped copy).
#
# Checks for layout/<cell> (default lna_core):
#   1. sha256(<cell>.gds) == gds_sha256 in <cell>.provenance.json
#   2. layout/lvs_reference.py regenerated from the current netlist
#      byte-equals the committed <cell>.lvs_reference.spice
#   3. provenance.input of drc_report.json, lvs_full_report.json,
#      extract_report.json and lvs_report.json (scoped LVS) has
#      role == "layout" and content_hash == sha256:<committed GDS sha256>
#   4. lvs_inputs.json (issue #130) binds each LVS report's exact bytes to the
#      GDS, reference netlist and request bytes of the invocation that made
#      it; any changed relationship is reported by name
#   5. the output named by extract_report.json (netlist_path, relative to the
#      report dir, repo-local) hashes byte-for-byte to netlist_sha256 (#176)
#   6. the native DRC pair (issue #185): native_drc_report.json +
#      native_drc_inputs.json, written by layout/run_native_drc.py, may be
#      entirely absent (no native verdict exists until issue #201 supplies
#      one) but never one-sided; when both exist the sidecar must bind the
#      report's exact bytes and the committed GDS, match the report's own
#      status and provenance deck/pdk, and record a standalone executable
#      version >= its recorded minimum
#
# Usage: check-layout-freshness [--root DIR] [--cell NAME]
set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
CELL=lna_core
while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT="$2"; shift 2 ;;
    --cell) CELL="$2"; shift 2 ;;
    *) echo "usage: $0 [--root DIR] [--cell NAME]" >&2; exit 2 ;;
  esac
done

exec python3 -I - "$ROOT" "$CELL" <<'PY'
import hashlib, json, re, shutil, subprocess, sys, tempfile
from pathlib import Path

root, cell = Path(sys.argv[1]).resolve(), sys.argv[2]
cd = root / "layout" / cell
errs = []

def fail(rel, msg):
    errs.append(f"layout-freshness: {rel}: {msg}")

def load(p):
    try:
        return json.loads(p.read_text())
    except Exception as e:
        fail(p.relative_to(root), f"unreadable JSON ({e})")
        return None

gds = cd / f"{cell}.gds"
gds_sha = None
if gds.is_file():
    gds_sha = hashlib.sha256(gds.read_bytes()).hexdigest()
else:
    fail(gds.relative_to(root), "missing")

# 1. GDS vs provenance
prov = load(cd / f"{cell}.provenance.json")
if prov is not None and gds_sha is not None:
    want = prov.get("gds_sha256")
    if want != gds_sha:
        fail(f"layout/{cell}/{cell}.provenance.json",
             f"gds_sha256 {want!r} != sha256 of committed GDS {gds_sha}")

# 2. regenerate the LVS reference in a temp repo-shaped copy
committed = cd / f"{cell}.lvs_reference.spice"
rz = load(cd / "realization.json")
if rz is not None:
    net_rel = rz.get("netlist")
    srcs = {
        "layout/lvs_reference.py": root / "layout" / "lvs_reference.py",
        f"layout/{cell}/realization.json": cd / "realization.json",
        str(net_rel): root / str(net_rel),
    }
    missing = [k for k, v in srcs.items() if not v.is_file()]
    if not net_rel or missing or not committed.is_file():
        fail(f"layout/{cell}", f"missing inputs for regeneration: "
             f"{missing or [committed.name]}")
    else:
        with tempfile.TemporaryDirectory() as t:
            t = Path(t)
            for k, v in srcs.items():
                (t / k).parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(v, t / k)
            r = subprocess.run(
                [sys.executable, "-I", str(t / "layout/lvs_reference.py"),
                 str(t / "layout" / cell)],
                capture_output=True, text=True)
            out = t / "layout" / cell / f"{cell}.lvs_reference.spice"
            if r.returncode != 0:
                fail(f"layout/{cell}/{cell}.lvs_reference.spice",
                     "regeneration failed against current netlist: "
                     + (r.stderr.strip() or r.stdout.strip()))
            elif out.read_bytes() != committed.read_bytes():
                fail(f"layout/{cell}/{cell}.lvs_reference.spice",
                     f"stale: differs from regeneration of {net_rel}")

# 3. report envelopes pinned to the committed GDS
# (extraction / scoped LVS are pinned to the GDS only; they are not signoff
# evidence. The extraction output digest is checked separately in step 5.)
for name in ("drc_report.json", "lvs_full_report.json",
             "extract_report.json", "lvs_report.json"):
    rel = f"layout/{cell}/{name}"
    rep = load(cd / name)
    if rep is None:
        continue
    inp = (rep.get("provenance") or {}).get("input")
    if not isinstance(inp, dict):
        fail(rel, "missing provenance.input")
        continue
    if inp.get("role") != "layout":
        fail(rel, f"provenance.input.role is {inp.get('role')!r}, want 'layout'")
    ch = inp.get("content_hash")
    if not isinstance(ch, str) or not ch.startswith("sha256:"):
        fail(rel, f"provenance.input.content_hash missing or malformed ({ch!r})")
    elif gds_sha is not None and ch[len("sha256:"):] != gds_sha:
        fail(rel, f"provenance.input.content_hash {ch} != sha256:{gds_sha} (committed GDS)")

# 5. extraction output named by extract_report.json (issue #176): the file at
# netlist_path (relative to the report's directory, repo-local) must hash,
# byte for byte, to netlist_sha256.
def check_extract_output():
    rel = f"layout/{cell}/extract_report.json"
    rep = load(cd / "extract_report.json") if (cd / "extract_report.json").is_file() else None
    if not isinstance(rep, dict):
        return  # missing/unreadable already reported by step 3
    npath, nsha = rep.get("netlist_path"), rep.get("netlist_sha256")
    ok = True
    if not isinstance(npath, str) or not npath or "\0" in npath:
        fail(rel, f"netlist_path missing or malformed ({npath!r})"); ok = False
    elif Path(npath).is_absolute():
        fail(rel, f"netlist_path {npath!r} is absolute; must be relative to the report directory"); ok = False
    if not isinstance(nsha, str) or len(nsha) != 64 or any(c not in "0123456789abcdef" for c in nsha):
        fail(rel, f"netlist_sha256 missing or malformed ({nsha!r}); want 64 lowercase hex"); ok = False
    if not ok:
        return
    out = (cd / npath).resolve()
    if not out.is_relative_to(root):
        fail(rel, f"netlist_path {npath!r} escapes the repository"); return
    if not out.is_file():
        fail(rel, f"netlist_path {npath!r}: extraction output {out.relative_to(root)} missing"); return
    got = hashlib.sha256(out.read_bytes()).hexdigest()
    if got != nsha:
        fail(rel, f"extraction output {out.relative_to(root)} sha256 {got} != "
             f"netlist_sha256 {nsha}; rerun layout/run_flow.sh")

check_extract_output()

# 4. LVS input identity sidecar (written by layout/lvs_identity.py)
def sha(p):
    return hashlib.sha256(p.read_bytes()).hexdigest()

side_rel = f"layout/{cell}/lvs_inputs.json"
side = load(cd / "lvs_inputs.json") if (cd / "lvs_inputs.json").is_file() else None
if side is None and not (cd / "lvs_inputs.json").is_file():
    fail(side_rel, "missing (regenerate with layout/run_flow.sh)")
if side is not None:
    reps = side.get("reports") if isinstance(side, dict) else None
    if not isinstance(side, dict) or side.get("schema") != "sg13g2-lna.lvs-inputs/1" \
            or not isinstance(reps, dict):
        fail(side_rel, "malformed (bad schema or reports)")
        reps = None
    for rep_name, req_name in (("lvs_report.json", "lvs_request.json"),
                               ("lvs_full_report.json", "lvs_full_request.json")):
        if reps is None:
            break
        rel = f"{side_rel}[{rep_name}]"
        e = reps.get(rep_name)
        keys = ("request", "request_sha256", "reference", "reference_sha256",
                "gds", "gds_sha256", "report_sha256")
        if not isinstance(e, dict) or any(not isinstance(e.get(k), str) for k in keys):
            fail(rel, "missing or malformed entry")
            continue
        def cmp(what, recorded, path):
            if not path.is_file():
                fail(rel, f"{what}: {path.relative_to(root) if path.is_relative_to(root) else path} missing")
            elif sha(path) != recorded:
                fail(rel, f"{what} changed since this LVS ran "
                     f"(recorded {recorded[:12]}, now {sha(path)[:12]}); rerun layout/run_flow.sh")
        if e["request"] != req_name:
            fail(rel, f"request is {e['request']!r}, want {req_name!r}")
        cmp(f"request {req_name}", e["request_sha256"], cd / req_name)
        cmp(f"report {rep_name}", e["report_sha256"], cd / rep_name)
        # reference / GDS: paths come from the committed request, and the
        # recorded paths must agree with them.
        try:
            spec = json.loads((cd / req_name).read_bytes())
            ref_p = (cd / spec["reference"]["netlist"]).resolve()
            gds_p = (cd / spec["layout"]["file"]).resolve()
        except Exception as ex:
            fail(rel, f"cannot resolve reference/layout from {req_name} ({ex})")
            continue
        for what, path, key in (("reference", ref_p, "reference"), ("gds", gds_p, "gds")):
            try:
                want = str(path.relative_to(root))
            except ValueError:
                want = str(path)
            if e[key] != want:
                fail(rel, f"{what} path {e[key]!r} != {want!r} named by {req_name}")
        cmp(f"reference netlist {e['reference']}", e["reference_sha256"], ref_p)
        cmp(f"GDS {e['gds']}", e["gds_sha256"], gds_p)

# 6. native DRC pair (written by layout/run_native_drc.py, issue #185).
#    Entirely absent: allowed — no native verdict exists in this tree until
#    issue #201 supplies one. One-sided or inconsistent: fails, naming it.
NATIVE_REPORT = "native_drc_report.json"
NATIVE_SIDE = "native_drc_inputs.json"
NATIVE_STATUSES = ("clean", "violations", "coverage_unknown")

def vtuple(s):
    m = re.search(r"\d+(?:\.\d+)+", s)
    return tuple(int(x) for x in m.group(0).split(".")) if m else None

def check_native_pair():
    rep_p, side_p = cd / NATIVE_REPORT, cd / NATIVE_SIDE
    if not rep_p.is_file() and not side_p.is_file():
        return  # absent: allowed
    nrep_rel, nside_rel = f"layout/{cell}/{NATIVE_REPORT}", f"layout/{cell}/{NATIVE_SIDE}"
    if not rep_p.is_file():
        fail(nside_rel, f"{NATIVE_REPORT} missing: native report/sidecar pair is one-sided")
        return
    if not side_p.is_file():
        fail(nrep_rel, f"{NATIVE_SIDE} missing: native report/sidecar pair is one-sided")
        return
    side = load(side_p)
    rep = load(rep_p)
    rel = nside_rel
    if side is None or rep is None:
        return
    if not isinstance(side, dict) or side.get("schema") != "sg13g2-lna.native-drc/1":
        fail(rel, "malformed (bad schema)")
        return
    keys = ("report", "report_sha256", "status", "gds", "gds_sha256", "pdk",
            "klayout_exe", "klayout_exe_resolved", "klayout_exe_version",
            "min_klayout_version")
    missing = [k for k in keys if not isinstance(side.get(k), str) or not side[k]]
    if missing:
        fail(rel, f"missing or malformed field(s): {', '.join(missing)}")
        return
    for k in ("deck_binding", "pdk_binding"):
        if k not in side:
            fail(rel, f"missing {k}")
            return
    if side["report"] != NATIVE_REPORT:
        fail(rel, f"report is {side['report']!r}, want {NATIVE_REPORT!r}")
        return
    klt = side.get("klt")
    if not isinstance(klt, dict) or not isinstance(klt.get("version"), str) \
            or not klt["version"]:
        fail(rel, "klt identity missing or malformed")
        return
    argv = side.get("argv")
    if not isinstance(argv, list) or not argv \
            or any(not isinstance(a, str) for a in argv):
        fail(rel, "argv missing or malformed")
        return
    if sha(rep_p) != side["report_sha256"]:
        fail(rel, f"report changed since this native run (recorded "
             f"{side['report_sha256'][:12]}, now {sha(rep_p)[:12]}); "
             f"rerun layout/run_native_drc.py")
    try:
        want_gds = str(gds.resolve().relative_to(root))
    except ValueError:
        want_gds = str(gds.resolve())
    if side["gds"] != want_gds:
        fail(rel, f"gds path {side['gds']!r} != {want_gds!r}")
    elif gds_sha is not None and side["gds_sha256"] != gds_sha:
        fail(rel, f"GDS changed since this native run (recorded "
             f"{side['gds_sha256'][:12]}, now {gds_sha[:12]}); "
             f"rerun layout/run_native_drc.py")
    # the report itself must pin the committed GDS and carry the recorded verdict
    prov = rep.get("provenance") if isinstance(rep, dict) else None
    inp = (prov or {}).get("input")
    if not isinstance(inp, dict):
        fail(nrep_rel, "missing provenance.input")
    else:
        if inp.get("role") != "layout":
            fail(nrep_rel, f"provenance.input.role is {inp.get('role')!r}, want 'layout'")
        ch = inp.get("content_hash")
        if not isinstance(ch, str) or not ch.startswith("sha256:"):
            fail(nrep_rel, f"provenance.input.content_hash missing or malformed ({ch!r})")
        elif gds_sha is not None and ch[len("sha256:"):] != gds_sha:
            fail(nrep_rel, f"provenance.input.content_hash {ch} != sha256:{gds_sha} (committed GDS)")
    if not isinstance(rep, dict) or rep.get("status") not in NATIVE_STATUSES:
        got = rep.get("status") if isinstance(rep, dict) else type(rep).__name__
        fail(nrep_rel, f"status is {got!r}, want one of {list(NATIVE_STATUSES)}")
    elif side["status"] != rep["status"]:
        fail(rel, f"status {side['status']!r} != report status {rep['status']!r}")
    # deck / pdk bindings must equal what the report itself records
    if isinstance(prov, dict):
        for k, want in (("deck_binding", prov.get("deck")),
                        ("pdk_binding", prov.get("pdk"))):
            if side[k] != want:
                fail(rel, f"{k} differs from the report's provenance; "
                     f"rerun layout/run_native_drc.py")
    # recorded executable must satisfy the recorded minimum
    vt_min, vt_exe = vtuple(side["min_klayout_version"]), vtuple(side["klayout_exe_version"])
    if vt_min is None:
        fail(rel, f"min_klayout_version {side['min_klayout_version']!r} unparseable")
    if vt_exe is None:
        fail(rel, f"klayout_exe_version {side['klayout_exe_version']!r} unparseable")
    if vt_min is not None and vt_exe is not None:
        n = max(len(vt_min), len(vt_exe))
        a, b = vt_exe + (0,) * (n - len(vt_exe)), vt_min + (0,) * (n - len(vt_min))
        if a < b:
            fail(rel, f"klayout_exe_version {side['klayout_exe_version']!r} "
                 f"is below min_klayout_version {side['min_klayout_version']!r}")

check_native_pair()

if errs:
    print("\n".join(errs), file=sys.stderr)
    print(f"layout-freshness: FAILED ({len(errs)} problem(s))", file=sys.stderr)
    sys.exit(1)
print(f"layout-freshness: ok ({cell})")
PY
