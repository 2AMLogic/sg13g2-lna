#!/usr/bin/env bash
# Check that every sim/ record id cited in tracked docs resolves to
# committed evidence (issue #75).
#
# Record ids are <YYYYMMDD>-<HHMMSS>-<short-git-sha> (see sim/README.md).
# Every id found in a tracked *.md / *.json (outside .loom/, .agents/,
# .claude/) must appear in at least one tracked path under
# sim/*/records/, sim/*/corners/ or sim/*/netlist-snapshots/, or be listed
# in the allowlist (id + reason). Read-only; stdlib bash/python3 only.
#
# Usage: check-record-citations [--root DIR] [--allowlist FILE]
# Allowlist format: one "<id> <reason...>" per line; '#' comments, blanks ok.
# A reason is required.

set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
ALLOW=""
while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT="$2"; shift 2 ;;
    --allowlist) ALLOW="$2"; shift 2 ;;
    *) echo "usage: $0 [--root DIR] [--allowlist FILE]" >&2; exit 2 ;;
  esac
done
[ -n "$ALLOW" ] || ALLOW="$ROOT/.github/record-citation-allowlist.txt"

cd "$ROOT"
git ls-files -z | python3 -I -c '
import re, sys
allow_path = sys.argv[1]
files = [f for f in sys.stdin.buffer.read().decode().split("\0") if f]
ID = re.compile(r"(?<![0-9A-Za-z])\d{8}-\d{6}-[0-9a-f]{7,40}(?![0-9A-Za-z])")
EVID = re.compile(r"^sim/[^/]+/(records|corners|netlist-snapshots)/")
evidence = "\n".join(f for f in files if EVID.match(f))
allow = {}
try:
    with open(allow_path) as fh:
        for n, line in enumerate(fh, 1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split(None, 1)
            if len(parts) < 2 or not ID.fullmatch(parts[0]):
                print("ERROR: %s:%d: need \"<record-id> <reason>\"" % (allow_path, n))
                sys.exit(1)
            allow[parts[0]] = parts[1]
except FileNotFoundError:
    pass
skip = (".loom/", ".agents/", ".claude/")
bad = 0
for f in files:
    if not f.endswith((".md", ".json")) or f.startswith(skip):
        continue
    try:
        text = open(f, encoding="utf-8", errors="replace").read()
    except OSError:
        continue
    for n, line in enumerate(text.splitlines(), 1):
        for m in ID.finditer(line):
            i = m.group(0)
            if i in evidence or i in allow:
                continue
            print("DANGLING: %s:%d cites %s (no tracked sim/*/{records,corners,netlist-snapshots}/ path)" % (f, n, i))
            bad += 1
if bad:
    print("FAIL: %d dangling record citation(s)" % bad)
    sys.exit(1)
print("OK: all cited record ids resolve or are allowlisted")
' "$ALLOW"
