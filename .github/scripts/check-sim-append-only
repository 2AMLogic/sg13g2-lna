#!/usr/bin/env bash
# Enforce the sim/ append-only rule mechanically (issue #67).
#
# sim/README.md "Append-only rule": records/*.md, records/*.csv,
# netlist-snapshots/** and corners/** files are never edited or deleted
# after creation; a correction or re-run always mints a new <record-id>.
# This gate fails if HEAD modifies, deletes, renames away from, or changes
# the type of any path that exists at the merge base with BASE and matches
#
#   sim/*/records/**   sim/*/netlist-snapshots/**   sim/*/corners/**
#
# Pure additions pass (errata are new records, so they are never blocked).
# There is deliberately no override (no label, PR-body line or allowlist).
# Renames are diffed with --no-renames, so the old path reports as D.
# A mode-only change reports as M and fails. Bash + git only, read-only.
#
# Usage: check-sim-append-only --base REF [--root DIR]
# Exit: 0 clean, 1 violation(s) (each printed with its status letter),
#       2 usage or git error (missing/unknown base ref, shallow history
#       without a merge base, not a git repo) -- fails closed.

set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
BASE=""
usage() { echo "usage: $0 --base REF [--root DIR]" >&2; exit 2; }
while [ $# -gt 0 ]; do
  case "$1" in
    --base) [ $# -ge 2 ] || usage; BASE="$2"; shift 2 ;;
    --root) [ $# -ge 2 ] || usage; ROOT="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[ -n "$BASE" ] || usage

err() { echo "check-sim-append-only: error: $*" >&2; exit 2; }

cd "$ROOT" 2>/dev/null || err "cannot cd to root '$ROOT'"
git rev-parse --git-dir >/dev/null 2>&1 || err "'$ROOT' is not a git repository"
git rev-parse --verify --quiet "HEAD^{commit}" >/dev/null || err "HEAD does not resolve to a commit"
git rev-parse --verify --quiet "$BASE^{commit}" >/dev/null \
  || err "base ref '$BASE' does not resolve to a commit (fetch it, e.g. 'git fetch origin <branch>', with full history)"
MB="$(git merge-base "$BASE" HEAD 2>/dev/null)" \
  || err "no merge base between '$BASE' and HEAD (shallow clone? use fetch-depth: 0)"

OUT="$(mktemp)" || err "mktemp failed"
trap 'rm -f "$OUT"' EXIT
git diff -z --name-status --no-renames --diff-filter=MDT "$MB" HEAD -- \
  ':(glob)sim/*/records/**' \
  ':(glob)sim/*/netlist-snapshots/**' \
  ':(glob)sim/*/corners/**' > "$OUT" \
  || err "git diff failed"

n=0
while IFS= read -r -d '' status && IFS= read -r -d '' path; do
  [ $n -eq 0 ] && echo "sim/ append-only rule violated (vs merge base ${MB:0:12} of $BASE):"
  printf '  %s\t%s\n' "$status" "$path"
  n=$((n+1))
done < "$OUT"

if [ $n -gt 0 ]; then
  echo "$n committed evidence path(s) modified/deleted/renamed. Evidence under"
  echo "sim/*/{records,netlist-snapshots,corners}/ is never edited or deleted;"
  echo "a correction or re-run mints a new <record-id> (see sim/README.md)."
  exit 1
fi
echo "OK: no committed sim/ evidence modified, deleted or renamed (vs $BASE)."
exit 0
