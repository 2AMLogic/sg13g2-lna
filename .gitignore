.DS_Store
# ngspice BSIM4 parameter-check scratch file, written to the invocation cwd
bsim4v5.out

# sim/ harness: per-corner ngspice logs under corners/ are committed evidence
# (append-only record trail), so they escape the *.log rule.
!sim/*/corners/**/*.log
# same for a probe's committed decks/logs under netlist-snapshots/
# (issue #27 anomaly probe; the note record cites them as its evidence)
!sim/*/netlist-snapshots/**/*.log
# unit-test fixtures (trimmed ngspice logs) are committed test inputs
!sim/*/tests/fixtures/*.log
sim/build/
design/build/
# synthesis / P&R scratch
flow/build/
# local klt install, created by the setup script
.venv/
# Loom runtime account-ranking state (per agent runtime), sibling of the
# managed block's account-health.json (issue #470)
