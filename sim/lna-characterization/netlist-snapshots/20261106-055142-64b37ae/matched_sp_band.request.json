{
  "netlist": "matched_sp_band.spice",
  "models": {
    "pdk": "ihp-sg13g2"
  },
  "corners": {
    "process": [
      {
        "name": "typ",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerMOShv.lib",
            "section": "mos_tt"
          }
        ]
      },
      {
        "name": "bcs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerMOShv.lib",
            "section": "mos_ff"
          }
        ]
      },
      {
        "name": "wcs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerMOShv.lib",
            "section": "mos_ss"
          }
        ]
      },
      {
        "name": "sf",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerMOShv.lib",
            "section": "mos_sf"
          }
        ]
      },
      {
        "name": "fs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerMOShv.lib",
            "section": "mos_fs"
          }
        ]
      }
    ],
    "supply_v": {
      "vdd": [
        1.62,
        1.8,
        1.98
      ]
    },
    "temperature_c": [
      -40,
      27
    ]
  },
  "analysis": {
    "kind": "sp",
    "args": "lin 11 2.4e+09 2.4835e+09 1"
  },
  "measurements": [
    {
      "name": "s21_db_mid",
      "expr": "db(s_2_1)[5]",
      "unit": "dB"
    },
    {
      "name": "s21_db_min",
      "expr": "vecmin(db(s_2_1))",
      "unit": "dB"
    },
    {
      "name": "s21_db_max",
      "expr": "vecmax(db(s_2_1))",
      "unit": "dB"
    },
    {
      "name": "s11_db_mid",
      "expr": "db(s_1_1)[5]",
      "unit": "dB"
    },
    {
      "name": "s11_db_worst",
      "expr": "vecmax(db(s_1_1))",
      "unit": "dB"
    },
    {
      "name": "s22_db_mid",
      "expr": "db(s_2_2)[5]",
      "unit": "dB"
    },
    {
      "name": "s22_db_worst",
      "expr": "vecmax(db(s_2_2))",
      "unit": "dB"
    },
    {
      "name": "s12_db_mid",
      "expr": "db(s_1_2)[5]",
      "unit": "dB"
    },
    {
      "name": "mu_band_min",
      "expr": "vecmin(((1 - mag(s_1_1)^2)/(mag(s_2_2 - conj(s_1_1)*(s_1_1*s_2_2 - s_1_2*s_2_1)) + mag(s_1_2*s_2_1))))"
    },
    {
      "name": "k_band_min",
      "expr": "vecmin(((1 - mag(s_1_1)^2 - mag(s_2_2)^2 + mag((s_1_1*s_2_2 - s_1_2*s_2_1))^2)/(2*mag(s_1_2*s_2_1))))"
    },
    {
      "name": "nf_sp_db_mid",
      "expr": "real(NF[5])",
      "unit": "dB"
    },
    {
      "name": "nf_sp_db_worst",
      "expr": "vecmax(real(NF))",
      "unit": "dB"
    },
    {
      "name": "nfmin_sp_db_mid",
      "expr": "real(NFmin[5])",
      "unit": "dB"
    }
  ],
  "options": {
    "timeout_s": 900,
    "keep_artifacts": true,
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ],
    "stage_model_inputs": true,
    "ngspice_init": [
      "set numdgt=8"
    ]
  }
}
