{
  "netlist": "matched_sp_stab.spice",
  "models": {
    "pdk": "ihp-sg13g2"
  },
  "corners": {
    "process": [
      {
        "name": "typ",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerMOShv.lib",
            "section": "mos_tt"
          }
        ]
      },
      {
        "name": "bcs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerMOShv.lib",
            "section": "mos_ff"
          }
        ]
      },
      {
        "name": "wcs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerMOShv.lib",
            "section": "mos_ss"
          }
        ]
      },
      {
        "name": "sf",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerMOShv.lib",
            "section": "mos_sf"
          }
        ]
      },
      {
        "name": "fs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerMOShv.lib",
            "section": "mos_fs"
          }
        ]
      }
    ],
    "supply_v": {
      "vdd": [
        1.62,
        1.8,
        1.98
      ]
    },
    "temperature_c": [
      27
    ]
  },
  "analysis": {
    "kind": "sp",
    "args": "dec 40 1e+07 3e+10"
  },
  "measurements": [
    {
      "name": "mu_min",
      "expr": "vecmin(((1 - mag(s_1_1)^2)/(mag(s_2_2 - conj(s_1_1)*(s_1_1*s_2_2 - s_1_2*s_2_1)) + mag(s_1_2*s_2_1))))"
    },
    {
      "name": "n_mu_lt1",
      "expr": "mean(((1 - mag(s_1_1)^2)/(mag(s_2_2 - conj(s_1_1)*(s_1_1*s_2_2 - s_1_2*s_2_1)) + mag(s_1_2*s_2_1))) lt 1)*length(frequency)"
    },
    {
      "name": "f_mu_lt1_lo_hz",
      "expr": "vecmin(mag(frequency) + 1e12*(((1 - mag(s_1_1)^2)/(mag(s_2_2 - conj(s_1_1)*(s_1_1*s_2_2 - s_1_2*s_2_1)) + mag(s_1_2*s_2_1))) ge 1))",
      "unit": "Hz"
    },
    {
      "name": "f_mu_lt1_hi_hz",
      "expr": "vecmax(mag(frequency)*(((1 - mag(s_1_1)^2)/(mag(s_2_2 - conj(s_1_1)*(s_1_1*s_2_2 - s_1_2*s_2_1)) + mag(s_1_2*s_2_1))) lt 1))",
      "unit": "Hz"
    },
    {
      "name": "k_min",
      "expr": "vecmin(((1 - mag(s_1_1)^2 - mag(s_2_2)^2 + mag((s_1_1*s_2_2 - s_1_2*s_2_1))^2)/(2*mag(s_1_2*s_2_1))))"
    },
    {
      "name": "n_k_lt1",
      "expr": "mean(((1 - mag(s_1_1)^2 - mag(s_2_2)^2 + mag((s_1_1*s_2_2 - s_1_2*s_2_1))^2)/(2*mag(s_1_2*s_2_1))) lt 1)*length(frequency)"
    },
    {
      "name": "s11_mag_max",
      "expr": "vecmax(mag(s_1_1))"
    },
    {
      "name": "s22_mag_max",
      "expr": "vecmax(mag(s_2_2))"
    },
    {
      "name": "n_s22_gt1",
      "expr": "mean(mag(s_2_2) gt 1.000001)*length(frequency)"
    },
    {
      "name": "s11_mag_gt1_n",
      "expr": "mean(mag(s_1_1) gt 1.000001)*length(frequency)"
    },
    {
      "name": "n_pts",
      "expr": "length(frequency)"
    }
  ],
  "options": {
    "timeout_s": 900,
    "keep_artifacts": true,
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ],
    "stage_model_inputs": true,
    "ngspice_init": [
      "set numdgt=8"
    ]
  }
}
