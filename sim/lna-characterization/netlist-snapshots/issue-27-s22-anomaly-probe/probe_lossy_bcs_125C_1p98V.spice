*.iopin rfout
XQ2 outn vb2 casc vss npn13G2 Nx=8
XQ1 casc b1 e1 vss npn13G2 Nx=8
Le e1 vss 1n m=1
Rle e1 vss 153.42 m=1
Lc vdd lc_x 5n m=1
Rlc lc_x outn 7.67098 m=1
Cin xin b1 100p m=1
Cout outn xout 100p m=1
Lb lb_x rfin 4.56374n m=1
Rlb xin lb_x 7.00168 m=1
