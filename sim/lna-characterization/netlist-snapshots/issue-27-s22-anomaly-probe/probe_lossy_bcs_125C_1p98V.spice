pre_osdi /home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi
pre_osdi /home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi
pre_osdi /home/ubuntu/share/pdk/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi
save all
sp dec 4000 1e7 3e9
let m11 = mag(s_1_1)
let m22 = mag(s_2_2)
let s12s21 = mag(s_1_2*s_2_1)
let delta = s_1_1*s_2_2 - s_1_2*s_2_1
let mu = ((1 - m11^2)/(mag(s_2_2 - conj(s_1_1)*delta) + s12s21))
let k = ((1 - m11^2 - m22^2 + mag(delta)^2)/(2*s12s21))
let n_s22_gt1 = mean(m22 gt 1)*length(m22)
let n_s22_gt1_tol = mean(m22 gt 1.000001)*length(m22)
let n_mu_lt1 = mean(mu lt 1)*length(mu)
let n_k_lt1 = mean(k lt 1)*length(k)
print vecmax(m22) vecmin(mu) vecmin(k) n_s22_gt1 n_s22_gt1_tol n_mu_lt1 n_k_lt1 vecmax(m11)
print frequency[maxindex(m22)] frequency[maxindex(m11)] frequency[minindex(mu)] frequency[minindex(k)]
wrdata probe_lossy_bcs_125C_1p98V.table.txt frequency mu k m11 m22
quit
.endc
.end
