wrdata /home/ubuntu/GitHub/sg13g2-lna/.loom/worktrees/issue-193/sim/lna-matching-feasibility/corners/20261010-233800-d1312cc/scan_em5_cmim.inband.dat real(s_1_1) imag(s_1_1) real(s_2_1) imag(s_2_1) real(s_1_2) imag(s_1_2) real(s_2_2) imag(s_2_2) real(NF) real(NFmin) real(Rn) real(SOpt) imag(SOpt)
