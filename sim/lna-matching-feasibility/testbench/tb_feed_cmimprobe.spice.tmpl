* sg13g2-lna -- finite resonant base-feed study (issue #193), MIM-CAP PROBE
* Generated from sim/lna-matching-feasibility/testbench/tb_feed_cmimprobe.spice.tmpl
* by sim/lna-matching-feasibility/feed_study.py (plan) -- do not edit a
* generated netlist-snapshots/*.spice file, edit the template and re-run.
*
* Purpose: measure the pinned PDK cap_cmim subcircuit (cornerCAP.lib cap_typ)
* as a one-port at the sizes the plan chose from the closed-form
* C = cap_carea*W*L + 2*CJSW*(W+L), so the realised C and ESR at the band
* centre are measured rather than assumed. The PDK model carries only the
* 55 mOhm top-plate resistor: NO bottom-plate parasitic capacitance (the
* model header says it is added by extraction). That missing evidence is
* bracketed in the feed decks, not guessed here.

.lib "@@CAP_LIB@@" cap_typ

.options temp=27 tnom=27 gmin=1e-10

@@ONEPORTS@@

.control
set wr_singlescale
set wr_vecnames
option numdgt=10
ac lin 1 @@F_MID@@ @@F_MID@@
wrdata @@OUTDIR@@/cmim_probe.dat @@VECS@@
echo "DAT_WRITTEN cmim_probe.dat"
echo "BENCH_COMPLETE"
.endc
.end
