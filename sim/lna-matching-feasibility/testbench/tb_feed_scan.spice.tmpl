@@VARIANT_NOTES@@
*
* ONE PVT cell only: HBT_SECTION=hbt_typ MOS_SECTION=mos_tt TEMP=27 C
* VDD=1.80 V (the nominal cell). Single-corner exploration, NOT a PVT result
* and not a conformance claim against any spec/target-spec.md row. The DUT is
* design/netlist/lna.spice inlined verbatim (unresized, Le = 1 nH ideal, Lc
* 5 nH ideal) except the single BENCH EDIT that replaces R3b's line with the
* variant's feed (R3b = 330 Ohm and the bref reference are retained; bias is
* NOT retuned).
*
* Bench (as sim/lna-matching-feasibility/README.md "Bench definitions"):
*   - DC audit: `op`, then the `DC ...` echo line (collector currents, base
*     current, node voltages, supply current/power) for the validity checks.
*   - In-band `sp lin @@N_BAND@@ @@F_LO@@ @@F_HI@@ 1` (50 Ohm ports, donoise):
*     S-parameters, NF (50 Ohm source), NFmin, Rn, SOpt, referenced to the
*     ANALYSIS temperature (300.15 K); re-referenced to 290 K in the reducer.
*   - Broadband `sp dec @@N_STAB_DEC@@ @@F_STAB_LO@@ @@F_STAB_HI@@`: S-parameters
*     for mu, k, |Delta|, |S11|, |S22| (computed in the reducer).
*   - 50 Ohm-source NF at T0 = 290 K: second isolated copy Xb, Rs/RL noisy=0,
*     `noise v(nfout) vin lin @@N_NF@@ ...`, source term analytic
*     (NF = 10*log10(1 + inoise^2/(4*k*290*50))).
*   - `.options gmin=1e-10`.

.lib "@@MODELS_LIB@@" hbt_typ
.lib "@@MOS_LIB@@" mos_tt
@@FEED_INCLUDES@@

.options temp=27 tnom=27 gmin=1e-10

@@DUT@@

* --- Xa: S-parameter branch (50 Ohm ports at both ends) -----------------
Vdda vdda 0 dc 1.8
Vp1 pin 0 dc 0 ac 1 portnum 1 z0 50
Vp2 pout 0 dc 0 ac 0 portnum 2 z0 50
Xa vdda 0 pin pout lna

* --- Xb: 50 Ohm Thevenin source / 50 Ohm load, .noise --------------------
Vddb vddb 0 dc 1.8
Vin vin 0 dc 0 ac 1
Rs vin nfin 50 noisy=0
RL nfout 0 50 noisy=0
Xb vddb 0 nfin nfout lna

.control
pre_osdi @@OSDI_DIR@@/psp103.osdi
pre_osdi @@OSDI_DIR@@/psp103_nqs.osdi
pre_osdi @@OSDI_DIR@@/mosvar.osdi
set wr_singlescale
set wr_vecnames
option numdgt=10
op
let ic1 = @q.xa.xq1.qnpn13g2[ic]
let ic2 = @q.xa.xq2.qnpn13g2[ic]
let ib1 = @q.xa.xq1.qnpn13g2[ib]
let vb1 = v(xa.b1)
let ve1 = v(xa.e1)
let vcasc = v(xa.casc)
let voutn = v(xa.outn)
let vb2 = v(xa.vb2)
let vbref = v(xa.bref)
let idd = -i(vdda)
let pdc = 1.8 * (-i(vdda))
echo "DC ic1 $&ic1 ic2 $&ic2 ib1 $&ib1 vb1 $&vb1 ve1 $&ve1 vcasc $&vcasc voutn $&voutn vb2 $&vb2 vbref $&vbref idd $&idd pdc $&pdc"

sp lin @@N_BAND@@ @@F_LO@@ @@F_HI@@ 1
wrdata @@OUTDIR@@/@@STEM@@.inband.dat real(s_1_1) imag(s_1_1) real(s_2_1) imag(s_2_1) real(s_1_2) imag(s_1_2) real(s_2_2) imag(s_2_2) real(NF) real(NFmin) real(Rn) real(SOpt) imag(SOpt)
echo "DAT_WRITTEN @@STEM@@.inband.dat"

sp dec @@N_STAB_DEC@@ @@F_STAB_LO@@ @@F_STAB_HI@@
wrdata @@OUTDIR@@/@@STEM@@.stab.dat real(s_1_1) imag(s_1_1) real(s_2_1) imag(s_2_1) real(s_1_2) imag(s_1_2) real(s_2_2) imag(s_2_2)
echo "DAT_WRITTEN @@STEM@@.stab.dat"

noise v(nfout) vin lin @@N_NF@@ @@F_LO@@ @@F_HI@@
set lastplot = none
set specplot = none
foreach p $plots
  set specplot = $lastplot
  set lastplot = $p
end
setplot $specplot
let nf290 = 10*log10(1 + (inoise_spectrum^2)/(4*1.380649e-23*290*50))
wrdata @@OUTDIR@@/@@STEM@@.nf290.dat nf290
echo "DAT_WRITTEN @@STEM@@.nf290.dat"
echo "BENCH_COMPLETE"
.endc
.end
