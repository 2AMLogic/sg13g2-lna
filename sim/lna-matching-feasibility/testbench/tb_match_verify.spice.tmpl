* sg13g2-lna -- matching-network feasibility study, VERIFICATION deck
* (issue #186). Generated from
* sim/lna-matching-feasibility/testbench/tb_match_verify.spice.tmpl by
* sim/lna-matching-feasibility/matching_solver.py (solve) -- do not edit a
* generated netlist-snapshots/*.spice file, edit this template and re-run.
* Full bench definitions: sim/lna-matching-feasibility/README.md.
*
* Candidate: @@CANDIDATE@@   Q case: @@QCASE@@
@@CANDIDATE_NOTES@@
*
* ONE PVT cell only: HBT_SECTION=hbt_typ MOS_SECTION=mos_tt TEMP=27 C
* VDD=1.80 V (the nominal cell). Single-corner exploration, NOT a PVT
* result and not a conformance claim against any spec/target-spec.md row.
*
* Bench (identical to sim/lna-characterization's sp/NF/stability bench,
* restated here so the numbers cannot be separated from it):
*   - S-parameters: ngspice `sp` port sources, portnum/z0 = 50 Ohm at both
*     ports; in-band `sp lin @@N_BAND@@ @@F_LO@@ @@F_HI@@ 1` (donoise flag
*     set: ngspice two-port NF/NFmin, ANALYSIS-temperature referenced).
*   - Stability: `sp dec @@N_STAB_DEC@@ @@F_STAB_LO@@ @@F_STAB_HI@@`, mu
*     (Edwards-Sinsky), Rollett k, |Delta|, |S11|, |S22| per frequency.
*   - NF at T0 = 290 K: second, isolated copy Xb with its own VDD, 50 Ohm
*     Thevenin source Rs and 50 Ohm load RL both noisy=0, the source term
*     re-introduced analytically:
*     NF = 10*log10(1 + inoise_spectrum^2/(4*k*290*50)),
*     `noise v(nfout) vin lin @@N_NF@@ @@F_LO@@ @@F_HI@@` (sampled maximum,
*     not a continuous-band bound). Internal resistors (the inductor loss
*     resistors included) are noisy at the analysis temperature (300.15 K).
*   - `.options gmin=1e-10` (same override, same reason as
*     sim/lna-characterization/README.md "gmin and the DR-0003 core").
*
* Matched amplifier = subcircuit `lnam`: input network -> DUT -> output
* network. The DUT is design/netlist/lna.spice inlined verbatim except the
* edits marked 'BENCH EDIT' (Le loss resistor; Lc value / loss / EM model
* per the Q case). design/ itself is not modified. Every matching element
* below is external to the DUT and is a generic ideal C or an L with an
* explicit series loss resistor (R = w_mid*L/Q at 2.44175 GHz), or the
* EM-extracted inductor subcircuit where stated.

.lib "@@MODELS_LIB@@" hbt_typ
.lib "@@MOS_LIB@@" mos_tt
@@EM_INCLUDE@@

.options temp=27 tnom=27 gmin=1e-10

@@DUT@@

.subckt lnam vdd vss in out
@@INPUT_NET@@
Xdut vdd vss xin xout lna
@@OUTPUT_NET@@
.ends lnam

* --- Xa: S-parameter branch (50 Ohm ports at both ends) -----------------
Vdda vdda 0 dc 1.8
Vp1 pin 0 dc 0 ac 1 portnum 1 z0 50
Vp2 pout 0 dc 0 ac 0 portnum 2 z0 50
Xa vdda 0 pin pout lnam

* --- Xb: 50 Ohm Thevenin source / 50 Ohm load, .noise + transducer gain --
Vddb vddb 0 dc 1.8
Vin vin 0 dc 0 ac 1
Rs vin nfin 50 noisy=0
RL nfout 0 50 noisy=0
Xb vddb 0 nfin nfout lnam

.control
pre_osdi @@OSDI_DIR@@/psp103.osdi
pre_osdi @@OSDI_DIR@@/psp103_nqs.osdi
pre_osdi @@OSDI_DIR@@/mosvar.osdi
set wr_singlescale
set wr_vecnames
option numdgt=10
op
let ic1 = @q.xa.xdut.xq1.qnpn13g2[ic]
let ic2 = @q.xa.xdut.xq2.qnpn13g2[ic]
let idd = -i(vdda)
let pdc = 1.8 * (-i(vdda))
echo "OP ic1 $&ic1 ic2 $&ic2 idd $&idd pdc $&pdc"

* --- in-band S-parameters + ngspice two-port NF ------------------------
sp lin @@N_BAND@@ @@F_LO@@ @@F_HI@@ 1
wrdata @@OUTDIR@@/@@STEM@@.inband.dat real(s_1_1) imag(s_1_1) real(s_2_1) imag(s_2_1) real(s_1_2) imag(s_1_2) real(s_2_2) imag(s_2_2) real(NF) real(NFmin)
echo "DAT_WRITTEN @@STEM@@.inband.dat"

* --- broadband stability ------------------------------------------------
sp dec @@N_STAB_DEC@@ @@F_STAB_LO@@ @@F_STAB_HI@@
wrdata @@OUTDIR@@/@@STEM@@.stab.dat real(s_1_1) imag(s_1_1) real(s_2_1) imag(s_2_1) real(s_1_2) imag(s_1_2) real(s_2_2) imag(s_2_2)
echo "DAT_WRITTEN @@STEM@@.stab.dat"

* --- NF at T0 = 290 K over the in-band grid ----------------------------
noise v(nfout) vin lin @@N_NF@@ @@F_LO@@ @@F_HI@@
set lastplot = none
set specplot = none
foreach p $plots
  set specplot = $lastplot
  set lastplot = $p
end
setplot $specplot
let nf290 = 10*log10(1 + (inoise_spectrum^2)/(4*1.380649e-23*290*50))
wrdata @@OUTDIR@@/@@STEM@@.nf290.dat nf290
echo "DAT_WRITTEN @@STEM@@.nf290.dat"

* --- transducer-gain cross-check at the band centre --------------------
ac lin 1 @@F_MID@@ @@F_MID@@
let gt_mid = db(2*v(nfout))
echo "GAIN mid $&gt_mid"
echo "BENCH_COMPLETE"
.endc
.end
